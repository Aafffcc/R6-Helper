# 复制本文件为 .env.local 并填写（.env.local 已被 git 忽略，不会提交）
# 凭据来源：uniCloud 控制台（https://unicloud.dcloud.net.cn）-> 对应空间 -> 服务空间详情
# 注意：支付宝云空间没有 clientSecret（那是阿里云空间的参数）

VITE_UNICLOUD_SPACE_ID=
VITE_UNICLOUD_ACCESS_KEY=
VITE_UNICLOUD_SECRET_KEY=
VITE_UNICLOUD_SPACE_APP_ID=

# 可选：静态图片（操作员/武器/战队/联赛/地图/皮肤/挂件）托管基址，留空则图鉴显示首字母占位块
VITE_ASSET_BASE_URL=

# 可选：asset-import 云函数 URL 化地址（仅 npm run gen:upload-assets 上传脚本使用，小程序不读取）
UNICLOUD_ASSET_IMPORT_URL=
