{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/stats/stats",
      "style": {
        "navigationBarTitleText": "R6-Helper"
      }
    },
    {
      "path": "pages/player/player",
      "style": {
        "navigationBarTitleText": "战绩详情"
      }
    },
    {
      "path": "pages/library/library",
      "style": {
        "navigationBarTitleText": "资料库"
      }
    },
    {
      "path": "pages/esports/esports",
      "style": {
        "navigationBarTitleText": "电竞"
      }
    },
    {
      "path": "pages/agent/agent",
      "style": {
        "navigationBarTitleText": "Agent"
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "tabBar": {
    "color": "#9aa1ac",
    "selectedColor": "#ff8c1a",
    "backgroundColor": "#16181d",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/stats/stats",
        "text": "战绩",
        "iconPath": "static/tabbar/stats.png",
        "selectedIconPath": "static/tabbar/stats-selected.png"
      },
      {
        "pagePath": "pages/esports/esports",
        "text": "电竞",
        "iconPath": "static/tabbar/esports.png",
        "selectedIconPath": "static/tabbar/esports-selected.png"
      },
      {
        "pagePath": "pages/library/library",
        "text": "资料库",
        "iconPath": "static/tabbar/library.png",
        "selectedIconPath": "static/tabbar/library-selected.png"
      },
      {
        "pagePath": "pages/agent/agent",
        "text": "Agent",
        "iconPath": "static/tabbar/agent.png",
        "selectedIconPath": "static/tabbar/agent-selected.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-selected.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "R6-Helper",
    "navigationBarBackgroundColor": "#16181d",
    "backgroundColor": "#16181d"
  }
}
