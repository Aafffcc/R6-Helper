{
  "name": "r6-helper",
  "version": "0.1.0",
  "private": true,
  "description": "彩虹六号战绩查询小程序（uni-app + Vue 3 + TypeScript + uniCloud）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "gen:static-data": "node scripts/generate-static-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run type-check && npm run test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "@qiun/ucharts": "^2.5.0-20230101",
    "@wot-ui/ui": "^2.3.2",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030220261016001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.0",
    "@vue/runtime-core": "3.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "miniprogram-api-typings": "^5.2.3",
    "prettier": "^3.6.2",
    "sass": "^1.80.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.40.0",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
